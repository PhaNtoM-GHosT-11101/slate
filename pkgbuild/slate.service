[Unit]
Description=Slate express-key helper for the VEIKK A15
Documentation=https://github.com/PhaNtoM-GHosT-11101/slate
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/slate --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
